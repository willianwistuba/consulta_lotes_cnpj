def esperar(segundos, motivo):
    """Espera mostrando contagem regressiva na mesma linha da saída."""
    fim = time.monotonic() + segundos
    if segundos < 2:
        time.sleep(max(0.0, segundos))
        return
    while True:
        resta = fim - time.monotonic()
        if resta <= 0:
            break
        print(f"\r      ⏳ {motivo}: {resta:4.0f}s ", end="", flush=True)
        time.sleep(min(1.0, resta))
    print(f"\r      ⏳ {motivo}: ok{' ' * 12}", flush=True)


