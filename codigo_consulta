def _escalar_txt(v):
    if v is None:
        return ""
    if isinstance(v, bool):
        return "Sim" if v else "Não"
    if isinstance(v, (dict, list)):
        return ""
    return str(v)


def render_txt(obj, nivel=0):
    pad = "    " * nivel
    linhas = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            if isinstance(v, (dict, list)) and v:
                linhas.append(f"{pad}{k}:")
                linhas += render_txt(v, nivel + 1)
            else:
                linhas.append(f"{pad}{k}: {_escalar_txt(v)}")
    elif isinstance(obj, list):
        for i, item in enumerate(obj, 1):
            if isinstance(item, (dict, list)) and item:
                linhas.append(f"{pad}[{i}]")
                linhas += render_txt(item, nivel + 1)
            else:
                linhas.append(f"{pad}- {_escalar_txt(item)}")
    else:
        linhas.append(pad + _escalar_txt(obj))
    return linhas


def bloco_txt(item):
    linhas = ["=" * 80, f"CNPJ {item['cnpj_formatado']}", "=" * 80]
    if item.get("observacao"):
        linhas.append(f"Observação: {item['observacao']}")
    for reg in item["fontes"].values():
        linhas += [
            "",
            f"--- Fonte: {reg['fonte']} ---",
            f"URL consultada: {reg['url']}",
            f"Consultado em: {reg['consultado_em']}",
            f"Status: {ROTULO_STATUS.get(reg['status'], reg['status'])} (HTTP {reg['http_status']})",
        ]
        if reg.get("mensagem"):
