def g(obj, *caminho):
    for passo in caminho:
        if isinstance(obj, dict):
            obj = obj.get(passo)
        elif isinstance(obj, list) and isinstance(passo, int) and -len(obj) <= passo < len(obj):
            obj = obj[passo]
        else:
            return None
        if obj is None:
            return None
    return obj


def juntar(*partes, sep=" "):
    return sep.join(str(p).strip() for p in partes if p not in (None, "") and str(p).strip())


def data_br(valor):
    if not valor:
        return ""
    s = str(valor).strip()
    m = re.match(r"^(\d{4})-(\d{2})-(\d{2})", s)
    return f"{m.group(3)}/{m.group(2)}/{m.group(1)}" if m else s


def numero(valor):
    if valor in (None, ""):
        return None
    try:
        return float(str(valor).replace(",", ".")) if not isinstance(valor, (int, float)) else float(valor)
    except ValueError:
        return None


def sim_nao(valor):
    if valor is None or valor == "":
        return ""
    if isinstance(valor, bool):
        return "Sim" if valor else "Não"
    s = str(valor).strip().lower()
    if s in ("sim", "s", "true", "1"):
        return "Sim"
    if s in ("não", "nao", "n", "false", "0"):
        return "Não"
    return str(valor)


def fmt_cnae(codigo):
    if codigo in (None, ""):
        return ""
    digitos = re.sub(r"\D", "", str(codigo))
    if 6 <= len(digitos) <= 7:
        d = digitos.zfill(7)
        return f"{d[:4]}-{d[4]}/{d[5:]}"
    return str(codigo)


def telefone(ddd, num):
    if not num:
        return ""
    return f"({ddd}) {num}" if ddd else str(num)


