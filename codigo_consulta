        if reg.get("dados"):
            linhas += ["", "Dados retornados:"] + render_txt(reg["dados"], 1)
    return "\n".join(linhas) + "\n"


def cabecalho_txt(meta):
    linhas = [
        "CONSULTA DE CNPJ EM LOTE",
        f"Gerado em: {meta['gerado_em']}",
        f"CNPJs consultados: {meta['total_cnpjs']}",
        "Fontes consultadas:",
    ]
    linhas += [f"  - {FONTES[k]['nome']}: {FONTES[k]['url'].format(cnpj='{CNPJ}')}" for k in meta["fontes"]]
    if meta.get("interrompido"):
        linhas.append("ATENÇÃO: execução interrompida; resultados parciais.")
    linhas += ["", "Aviso: " + AVISO_FONTES, ""]
    return "\n".join(linhas) + "\n"


def achatar(obj, prefixo="", saida=None):
    if saida is None:
        saida = {}
    if isinstance(obj, dict):
        if not obj and prefixo:
            saida[prefixo] = ""
        for k, v in obj.items():
            achatar(v, f"{prefixo}.{k}" if prefixo else str(k), saida)
    elif isinstance(obj, list):
        if not obj:
            saida[prefixo] = ""
        elif all(not isinstance(x, (dict, list)) for x in obj):
            saida[prefixo] = " | ".join("" if x is None else str(x) for x in obj)
        else:
            saida[prefixo] = json.dumps(obj, ensure_ascii=False)
    else:
        saida[prefixo] = obj
    return saida


def linhas_planas(resultados, chave_fonte=None):
    linhas = []
    for item in resultados:
        for chave, reg in item["fontes"].items():
            if chave_fonte and chave != chave_fonte:
                continue
            base = {
                "CNPJ consultado": item["cnpj_formatado"],
                "Fonte": reg["fonte"],
                "Status da consulta": ROTULO_STATUS.get(reg["status"], reg["status"]),
                "HTTP": reg["http_status"],
                "Mensagem": reg["mensagem"],
                "Consultado em": reg["consultado_em"],
                "URL consultada": reg["url"],
            }
            base.update(achatar(reg["dados"]) if reg.get("dados") else {})
            linhas.append(base)
    return linhas


RE_CTRL = re.compile(r"[\x00-\x08\x0B\x0C\x0E-\x1F]")
LIMITE_CELULA = 32000


def _limpar_excel(v):
    if isinstance(v, str):
        v = RE_CTRL.sub("", v)
        if len(v) > LIMITE_CELULA:
            v = v[:LIMITE_CELULA] + " [...] (truncado: ver JSON)"
    return v


def _df_excel(linhas, colunas=None):
    df = pd.DataFrame(linhas, columns=colunas)
    for c in df.columns:
        if df[c].dtype == object:
            df[c] = df[c].map(_limpar_excel)
    return df


def _formatar_aba(ws, df):
    from openpyxl.styles import Alignment, Font, PatternFill
    from openpyxl.utils import get_column_letter

    cabecalho = PatternFill("solid", fgColor="1F3864")
    for cel in ws[1]:
        cel.font = Font(bold=True, color="FFFFFF")
        cel.fill = cabecalho
        cel.alignment = Alignment(vertical="center", wrap_text=True)
    ws.freeze_panes = "A2"
    if ws.max_row > 1 and ws.max_column > 0:
        ws.auto_filter.ref = ws.dimensions
    for i, col in enumerate(df.columns, 1):
        amostra = [len(str(col))] + [len(str(v)) for v in df[col].head(300) if v is not None]
        ws.column_dimensions[get_column_letter(i)].width = max(10, min(55, max(amostra) + 2))
        if col == "Capital social (R$)":
            for linha in range(2, ws.max_row + 1):
                ws.cell(row=linha, column=i).number_format = "#,##0.00"


def exportar(resultados, invalidos, meta, opcoes, pasta):
    gerados = []
    os.makedirs(pasta, exist_ok=True)
    carimbo = meta["carimbo"]

    # a) TXT por CNPJ
    if "txt_por_cnpj" in opcoes:
        sub = os.path.join(pasta, "txt_por_cnpj")
        os.makedirs(sub, exist_ok=True)
        for item in resultados:
            caminho = os.path.join(sub, f"{item['cnpj']}.txt")
            with open(caminho, "w", encoding="utf-8") as f:
                f.write(cabecalho_txt({**meta, "total_cnpjs": 1}) + bloco_txt(item))
            gerados.append(caminho)

    # b) JSON por CNPJ
    if "json_por_cnpj" in opcoes:
        sub = os.path.join(pasta, "json_por_cnpj")
        os.makedirs(sub, exist_ok=True)
        for item in resultados:
            caminho = os.path.join(sub, f"{item['cnpj']}.json")
            with open(caminho, "w", encoding="utf-8") as f:
                json.dump(item, f, ensure_ascii=False, indent=2)
            gerados.append(caminho)

    # c) TXT consolidado
    if "txt_consolidado" in opcoes:
        caminho = os.path.join(pasta, f"cnpjs_consolidado_{carimbo}.txt")
        with open(caminho, "w", encoding="utf-8") as f:
            f.write(cabecalho_txt(meta))
            for item in resultados:
                f.write("\n" + bloco_txt(item))
            if invalidos:
                f.write("\n" + "=" * 80 + "\nCNPJs com dígito verificador inválido (não consultados)\n" + "=" * 80 + "\n")
                for inv in invalidos:
                    f.write(f"- {inv['entrada_original']}\n")
        gerados.append(caminho)

    # d) JSON consolidado
    if "json_consolidado" in opcoes:
        caminho = os.path.join(pasta, f"cnpjs_consolidado_{carimbo}.json")
        pacote = {
            "gerado_em": meta["gerado_em"],
            "aviso": AVISO_FONTES,
            "fontes": {k: {"nome": FONTES[k]["nome"], "url_modelo": FONTES[k]["url"]} for k in meta["fontes"]},
            "execucao": meta["estatisticas"],
            "interrompido": meta.get("interrompido", False),
            "cnpjs_invalidos_nao_consultados": invalidos,
            "resultados": resultados,
        }
        with open(caminho, "w", encoding="utf-8") as f:
            json.dump(pacote, f, ensure_ascii=False, indent=2)
        gerados.append(caminho)

    # e) CSV consolidado (uma linha por CNPJ x fonte; listas aninhadas em JSON)
    if "csv" in opcoes:
        caminho = os.path.join(pasta, f"cnpjs_consolidado_{carimbo}.csv")
        pd.DataFrame(linhas_planas(resultados)).to_csv(caminho, sep=";", index=False, encoding="utf-8-sig")
        gerados.append(caminho)

    # f) XLSX com abas
    if "xlsx" in opcoes:
        caminho = os.path.join(pasta, f"cnpjs_consolidado_{carimbo}.xlsx")
        resumo, tab_socios, tab_cnaes, log = [], [], [], []
        for item in resultados:
            for chave, reg in item["fontes"].items():
                linha = {"CNPJ": item["cnpj_formatado"], "Fonte": reg["fonte"],
                         "Status da consulta": ROTULO_STATUS.get(reg["status"], reg["status"])}
                if reg.get("dados"):
                    try:
                        r = RESUMIDORES[chave](reg["dados"])
                    except Exception as e:  # formato inesperado da fonte
                        r = {}
                        linha["Status da consulta"] += f" (resumo indisponível: {type(e).__name__})"
                    linha.update({CABECALHOS_RESUMO[k]: v for k, v in r.items()})
                    for s in socios(chave, reg["dados"]):
                        tab_socios.append({"CNPJ": item["cnpj_formatado"], "Fonte": reg["fonte"], **s})
                    for c in cnaes_secundarios(chave, reg["dados"]):
                        tab_cnaes.append({"CNPJ": item["cnpj_formatado"], "Fonte": reg["fonte"], **c})
                resumo.append(linha)
                log.append({
                    "CNPJ": item["cnpj_formatado"], "Fonte": reg["fonte"],
                    "Status": ROTULO_STATUS.get(reg["status"], reg["status"]),
                    "HTTP": reg["http_status"], "Mensagem": reg["mensagem"],
                    "Tentativas": reg["tentativas"], "Duração (s)": reg["duracao_s"],
                    "Consultado em": reg["consultado_em"], "URL": reg["url"],
                })

        abas = [
            ("Resumo", _df_excel(resumo, ["CNPJ", "Fonte", "Status da consulta"] + list(CABECALHOS_RESUMO.values()))),
            ("Sócios", _df_excel(tab_socios, ["CNPJ", "Fonte", "nome", "documento", "qualificacao", "data_entrada",
                                              "faixa_etaria", "representante_legal", "qualificacao_representante"])),
            ("CNAEs secundários", _df_excel(tab_cnaes, ["CNPJ", "Fonte", "codigo", "descricao"])),
        ]
        nomes_aba = {"minhareceita": "Minha Receita (completo)", "receitaws": "ReceitaWS (completo)",
                     "cnpjws": "CNPJ.ws (completo)"}
        for chave in meta["fontes"]:
            abas.append((nomes_aba[chave], _df_excel(linhas_planas(resultados, chave))))
        abas.append(("Log de consultas", _df_excel(log)))
        if invalidos:
            abas.append(("DV inválido", _df_excel(invalidos)))
        sobre = [
            {"Campo": "Gerado em", "Valor": meta["gerado_em"]},
            {"Campo": "CNPJs consultados", "Valor": meta["total_cnpjs"]},
            {"Campo": "Fontes", "Valor": ", ".join(FONTES[k]["nome"] for k in meta["fontes"])},
            {"Campo": "Execução interrompida?", "Valor": "Sim" if meta.get("interrompido") else "Não"},
            {"Campo": "Aviso", "Valor": AVISO_FONTES},
        ]
        abas.append(("Sobre", _df_excel(sobre)))

        with pd.ExcelWriter(caminho, engine="openpyxl") as writer:
            for nome, df in abas:
                df.to_excel(writer, sheet_name=nome[:31], index=False)
                _formatar_aba(writer.sheets[nome[:31]], df)
        gerados.append(caminho)

    return gerados




def empacotar(pasta, gerados):
    if not gerados:
        return None
    if len(gerados) == 1:
        return gerados[0]
    alvo = pasta.rstrip("/") + ".zip"
    with zipfile.ZipFile(alvo, "w", zipfile.ZIP_DEFLATED) as z:
        for caminho in gerados:
            z.write(caminho, os.path.relpath(caminho, os.path.dirname(pasta)))
    return alvo


