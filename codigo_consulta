# 1. Identificação e validação de CNPJs (numéricos e alfanuméricos)
# ==============================================================================
# CNPJ formatado dentro de texto corrido. Aceita o formato alfanumérico
# (12 posições com letras ou números + 2 dígitos verificadores numéricos).
RE_MASCARA = re.compile(
    r"(?<![A-Z0-9])[A-Z0-9]{2}\.[A-Z0-9]{3}\.[A-Z0-9]{3}/[A-Z0-9]{4}-\d{2}(?![A-Z0-9])",
    re.IGNORECASE,
)
RE_LIMPO = re.compile(r"^[A-Z0-9]{12}\d{2}$")
RE_SEPARADORES = re.compile(r"[\r\n;,\t]+")
RE_PONTUACAO = re.compile(r"[\s./\-\"']")

PESOS_1 = [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]
PESOS_2 = [6] + PESOS_1


def _dv(base, pesos):
    # Para o CNPJ alfanumérico, cada caractere vale (código ASCII - 48);
    # para dígitos isso dá o próprio número, então a regra serve para os dois.
    soma = sum((ord(c) - 48) * p for c, p in zip(base, pesos))
    resto = soma % 11
    return "0" if resto < 2 else str(11 - resto)


def dv_valido(cnpj):
    if not RE_LIMPO.match(cnpj) or len(set(cnpj)) == 1:
        return False
    d1 = _dv(cnpj[:12], PESOS_1)
    d2 = _dv(cnpj[:12] + d1, PESOS_2)
    return cnpj[12:] == d1 + d2


def formatar_cnpj(c):
    return f"{c[:2]}.{c[2:5]}.{c[5:8]}/{c[8:12]}-{c[12:]}" if len(c) == 14 else c


def extrair_cnpjs(texto):
    """Aceita: um por linha; separados por ; ou , (ou tabulação); e CNPJs
    formatados no meio de texto corrido. Devolve (válidos, inválidos, duplicados)."""
    texto = (texto or "").upper()
    candidatos = []  # (cnpj_limpo, trecho_original, observacao)

    for token in RE_SEPARADORES.split(texto):
        token = token.strip()
        if not token:
            continue
        formatados = RE_MASCARA.findall(token)
        if formatados:
            for f in formatados:
                candidatos.append((re.sub(r"[^A-Z0-9]", "", f), f, ""))
            continue
        limpo = RE_PONTUACAO.sub("", token)
        if limpo.isdigit() and 12 <= len(limpo) <= 13:
            # Caso típico de CNPJ colado do Excel sem os zeros à esquerda
            candidatos.append((limpo.zfill(14), token, "zeros à esquerda completados"))
        elif RE_LIMPO.match(limpo):
            candidatos.append((limpo, token, ""))

    validos, invalidos, duplicados, vistos = [], [], [], set()
    for limpo, original, obs in candidatos:
        if limpo in vistos:
            duplicados.append(original)
            continue
        vistos.add(limpo)
        registro = {"cnpj": limpo, "cnpj_formatado": formatar_cnpj(limpo),
                    "entrada_original": original, "observacao": obs}
        (validos if dv_valido(limpo) else invalidos).append(registro)
    return validos, invalidos, duplicados


