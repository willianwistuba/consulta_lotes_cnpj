def consultar_lote(texto, fontes=("minhareceita", "receitaws", "cnpjws"),
                   exports=("json_consolidado", "xlsx"), intervalos=None,
                   tentativas=3, timeout=30, incluir_invalidos=False, baixar=True):
    global ULTIMO_ARQUIVO
    fontes_sel = [k for k in FONTES if k in fontes]
    exports = set(exports)
    if not fontes_sel:
        print("⚠️ Nenhuma fonte selecionada.")
        return None
    if not exports:
        print("⚠️ Nenhum formato de exportação selecionado.")
        return None

    validos, invalidos, duplicados = extrair_cnpjs(texto)
    print(f"✔ {len(validos)} CNPJ(s) válido(s) e único(s) identificado(s).")
    if duplicados:
        print(f"↺ {len(duplicados)} repetido(s) ignorado(s).")
    if invalidos:
        print(f"✖ {len(invalidos)} com dígito verificador inválido"
              f"{' (serão consultados mesmo assim)' if incluir_invalidos else ' (não serão consultados)'}: "
              + ", ".join(i["entrada_original"] for i in invalidos[:15]) + (" ..." if len(invalidos) > 15 else ""))
    lista = validos + (invalidos if incluir_invalidos else [])
    if not lista:
        print("\nNenhum CNPJ para consultar. Confira o texto colado e execute a célula de novo.")
        return None

    ritmo = {k: float((intervalos or {}).get(k, FONTES[k]["intervalo"])) for k in fontes_sel}
    estimativa = len(lista) * max(ritmo.values()) + len(lista) * len(fontes_sel) * 0.7
    print(f"Fontes: {', '.join(FONTES[k]['nome'] for k in fontes_sel)}")
    print(f"Tempo estimado: ~{_fmt_tempo(estimativa)} para {len(lista)} CNPJ(s) x {len(fontes_sel)} fonte(s).")
    print("Para interromper, clique no ■ da célula: o que já foi consultado será exportado.")
    print("=" * 70, flush=True)

    resultados = []
    proxima = {k: 0.0 for k in fontes_sel}
    interrompido = False
    inicio = time.monotonic()
    n = len(lista)

    try:
        for i, entrada in enumerate(lista, 1):
            decorrido = time.monotonic() - inicio
            restante = (decorrido / (i - 1)) * (n - i + 1) if i > 1 else estimativa
            print(f"\n[{i}/{n}] {entrada['cnpj_formatado']}   ·   {hora()}   ·   "
                  f"{(i - 1) * 100 // n}% concluído   ·   restante ~{_fmt_tempo(restante)}", flush=True)
            item = {"cnpj": entrada["cnpj"], "cnpj_formatado": entrada["cnpj_formatado"],
                    "entrada_original": entrada["entrada_original"],
                    "observacao": entrada["observacao"], "fontes": {}}
            resultados.append(item)
            for k in fontes_sel:
                espera = proxima[k] - time.monotonic()
                if espera > 0:
                    esperar(espera, f"{FONTES[k]['nome']}: aguardando limite de consultas")
                print(f"      → {FONTES[k]['nome']}: consultando...", end="", flush=True)
                reg = consultar_fonte(k, entrada["cnpj"], timeout=timeout, max_tentativas=tentativas,
                                      log=lambda m: print("\n" + m, flush=True))
                proxima[k] = time.monotonic() + ritmo[k]
                item["fontes"][k] = reg
                nome = ""
                if reg["dados"]:
                    try:
                        nome = " · " + str(RESUMIDORES[k](reg["dados"]).get("razao_social") or "")
                    except Exception:
                        pass
                msg = f" · {reg['mensagem']}" if reg["status"] != "ok" and reg["mensagem"] else ""
                print(f"\r      → {FONTES[k]['nome']}: {ROTULO_STATUS.get(reg['status'], reg['status'])}"
                      f"{nome}{msg} ({reg['duracao_s']}s){' ' * 12}", flush=True)
    except KeyboardInterrupt:
        interrompido = True
        print("\n\n⏹️ Interrompido pelo usuário. Exportando o que já foi consultado...", flush=True)

    if resultados and not resultados[-1]["fontes"]:
        resultados.pop()
    if not resultados:
        print("Nada foi consultado; nenhum arquivo gerado.")
        return None

    estatisticas = {}
    for k in fontes_sel:
        cont = {}
        for item in resultados:
            reg = item["fontes"].get(k)
            if reg:
                cont[reg["status"]] = cont.get(reg["status"], 0) + 1
        estatisticas[FONTES[k]["nome"]] = cont

    momento = agora()
    meta = {
        "gerado_em": momento.strftime("%d/%m/%Y %H:%M:%S (%Z)"),
        "carimbo": momento.strftime("%Y%m%d_%H%M%S"),
        "fontes": fontes_sel,
        "total_cnpjs": len(resultados),
        "estatisticas": estatisticas,
        "interrompido": interrompido,
        "duracao_s": round(time.monotonic() - inicio, 1),
    }
    print("\n" + "=" * 70)
    print("📦 Gerando arquivos...", flush=True)
    pasta = os.path.join(PASTA_BASE, f"consulta_cnpj_{meta['carimbo']}")
    gerados = exportar(resultados, [] if incluir_invalidos else invalidos, meta, exports, pasta)
    ULTIMO_ARQUIVO = empacotar(pasta, gerados)

    for fonte, cont in estatisticas.items():
        partes = ", ".join(f"{ROTULO_STATUS.get(s, s)}: {q}" for s, q in cont.items())
        print(f"{fonte} → {partes}")
    print(f"Duração total: {_fmt_tempo(meta['duracao_s'])} · {len(gerados)} arquivo(s) gerado(s)")
    print(f"Pasta no Colab: {pasta}")
    print(f"Arquivo para download: {os.path.basename(ULTIMO_ARQUIVO)}")
    if baixar and EM_COLAB:
        try:
            colab_files.download(ULTIMO_ARQUIVO)
            print("⬇ Download iniciado. Se não começar, rode baixar_novamente() em outra célula "
                  "ou use o painel Arquivos (ícone de pasta à esquerda).")
        except Exception as e:
            print(f"⚠️ Download automático falhou ({e}). Use o painel Arquivos (ícone de pasta à esquerda).")
    print("✅ Fim. Para uma nova consulta, execute a célula de novo.")
    return resultados


