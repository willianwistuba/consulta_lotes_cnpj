SESSAO = requests.Session()
SESSAO.headers.update({
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) consulta-cnpj-lote/1.0",
    "Accept": "application/json",
})


def _mensagem_corpo(corpo):
    if isinstance(corpo, dict):
        for chave in ("message", "detalhes", "detahes", "titulo", "error"):
            if corpo.get(chave):
                return str(corpo[chave])
    return ""


def interpretar_resposta(chave, http, corpo):
    """Converte a resposta de cada fonte em (status, mensagem)."""
    msg = _mensagem_corpo(corpo)

    if http == 429:
        return "limite", msg or "limite de requisições atingido"

    # ReceitaWS costuma responder HTTP 200 com {"status": "ERROR", "message": ...}
    if chave == "receitaws" and isinstance(corpo, dict) and str(corpo.get("status", "")).upper() == "ERROR":
        m = msg.lower()
        if "too many" in m or "muitas" in m or "limite" in m:
            return "limite", msg
        if "inválido" in m or "invalido" in m:
            return "invalido", msg
        if "rejeitado" in m or "não encontrado" in m or "nao encontrado" in m or "not found" in m:
            return "nao_encontrado", msg
        return "erro", msg or "a fonte retornou erro"

    if http == 200:
        if isinstance(corpo, dict) and corpo:
            return "ok", ""
        return "erro", "resposta vazia ou fora do formato JSON"
    if http == 404:
        return "nao_encontrado", msg or "CNPJ não localizado na base da fonte"
    if http == 400:
        return "invalido", msg or "a fonte considerou o CNPJ inválido"
    if http in (401, 403):
        return "erro", msg or "acesso negado pela fonte (possível bloqueio do IP do Colab)"
    if http is not None and http >= 500:
        return "erro", msg or f"falha no servidor da fonte (HTTP {http})"
    return "erro", msg or f"HTTP {http}"


def _espera_limite(resposta, padrao=61):
    try:
        valor = int(float(resposta.headers.get("Retry-After", "")))
        return max(5, min(valor + 1, 180))
    except (TypeError, ValueError):
        return padrao


def consultar_fonte(chave, cnpj, timeout=30, max_tentativas=3, log=print):
    cfg = FONTES[chave]
    url = cfg["url"].format(cnpj=cnpj)
    reg = {
        "fonte": cfg["nome"], "chave_fonte": chave, "url": url,
        "status": None, "http_status": None, "mensagem": "",
        "tentativas": 0, "consultado_em": None, "duracao_s": None, "dados": None,
    }
    for tentativa in range(1, max_tentativas + 1):
        reg["tentativas"] = tentativa
        reg["consultado_em"] = agora_iso()
        inicio = time.monotonic()
        espera = 0
        corpo = None
        try:
            r = SESSAO.get(url, timeout=timeout)
            http = r.status_code
            try:
                corpo = r.json()
            except ValueError:
                corpo = None
            status, msg = interpretar_resposta(chave, http, corpo)
            if status == "limite":
                espera = _espera_limite(r)
            elif status == "erro" and (http >= 500):
                espera = 10 * tentativa
        except requests.Timeout:
            http, status, msg, espera = None, "erro", f"tempo esgotado ({timeout}s)", 10 * tentativa
        except requests.RequestException as e:
            http, status, msg, espera = None, "erro", f"falha de conexão: {type(e).__name__}", 10 * tentativa

        reg.update({
            "status": status, "http_status": http, "mensagem": msg,
            "duracao_s": round(time.monotonic() - inicio, 2),
            "dados": corpo if status == "ok" else None,
        })

        recuperavel = status == "limite" or (status == "erro" and espera > 0)
        if not recuperavel or tentativa == max_tentativas:
            break
        log(f"      ↻ {cfg['nome']}: {msg}. Nova tentativa ({tentativa + 1}/{max_tentativas}) após a espera.")
        esperar(espera, f"{cfg['nome']}: aguardando liberação")
    return reg


