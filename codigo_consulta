def _fmt_tempo(seg):
    seg = max(0, int(seg))
    if seg < 60:
        return f"{seg}s"
    m, s = divmod(seg, 60)
    if m < 60:
        return f"{m}min{s:02d}s"
    h, m = divmod(m, 60)
    return f"{h}h{m:02d}min"


