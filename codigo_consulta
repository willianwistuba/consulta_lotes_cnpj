    if (!/^[A-Z0-9]{12}\d{2}$/.test(c) || /^(.)\1{13}$/.test(c)) return false;
    const d1 = dv(c, P1), d2 = dv(c.slice(0, 12) + d1, P2);
    return c.slice(12) === String(d1) + String(d2);
  };
  const extrair = (t) => {
    const out = [];
    for (let tok of (t || "").toUpperCase().split(/[\r\n;,\t]+/)) {
      tok = tok.trim(); if (!tok) continue;
      const m = tok.match(/(?<![A-Z0-9])[A-Z0-9]{2}\.[A-Z0-9]{3}\.[A-Z0-9]{3}\/[A-Z0-9]{4}-\d{2}(?![A-Z0-9])/g);
      if (m) { m.forEach(x => out.push(x.replace(/[^A-Z0-9]/g, ""))); continue; }
      const l = tok.replace(/[\s.\/\-"']/g, "");
      if (/^\d{12,13}$/.test(l)) out.push(l.padStart(14, "0"));
      else if (/^[A-Z0-9]{12}\d{2}$/.test(l)) out.push(l);
    }
    const unicos = [...new Set(out)];
    const validos = unicos.filter(dvOk).length;
    return { validos, invalidos: unicos.length - validos, repetidos: out.length - unicos.length };
  };
  const marcados = (nome) => [...root.querySelectorAll(`input[name=${nome}]:checked`)].map(e => e.value);
  const tempo = (s) => s < 60 ? `${Math.round(s)}s` : (s < 3600 ? `${Math.round(s / 60)} min` : `${(s / 3600).toFixed(1)} h`);
  const atualizar = () => {
    const r = extrair($("-texto").value);
    const fontes = marcados("fonte");
    const incluir = $("-invalidos").checked;
    const n = r.validos + (incluir ? r.invalidos : 0);
    const maior = Math.max(0, ...fontes.map(f => parseFloat($("-int-" + f).value) || 0));
    let txt = `✔ ${r.validos} CNPJ(s) válido(s)`;
    if (r.invalidos) txt += ` · ✖ ${r.invalidos} com DV inválido`;
    if (r.repetidos) txt += ` · ↺ ${r.repetidos} repetido(s)`;
    if (n && fontes.length) txt += ` · tempo estimado ~${tempo(n * maior + n * fontes.length * 0.7)}`;
    $("-contador").textContent = (r.validos || r.invalidos) ? txt : "Nenhum CNPJ identificado ainda.";
  };
  root.addEventListener("input", atualizar);
  root.addEventListener("change", atualizar);

  return new Promise((resolve) => {
    $("-btn").onclick = () => {
      const fontes = marcados("fonte"), exps = marcados("exp");
      const r = extrair($("-texto").value);
      const aviso = $("-aviso");
      if (!r.validos && !(r.invalidos && $("-invalidos").checked)) { aviso.textContent = "Nenhum CNPJ válido identificado."; return; }
      if (!fontes.length) { aviso.textContent = "Marque pelo menos uma fonte."; return; }
      if (!exps.length) { aviso.textContent = "Marque pelo menos um formato de exportação."; return; }
      const num = (s, d) => { const v = parseFloat($(s).value); return isNaN(v) ? d : v; };
      const dados = {
        texto: $("-texto").value, fontes: fontes, exports: exps,
        intervalos: { minhareceita: num("-int-minhareceita", IV_MR), receitaws: num("-int-receitaws", IV_RW), cnpjws: num("-int-cnpjws", IV_CW) },
        tentativas: Math.round(num("-tentativas", 3)), timeout: Math.round(num("-timeout", 30)),
        incluir_invalidos: $("-invalidos").checked, baixar: $("-baixar").checked,
      };
      root.querySelectorAll("input, textarea, button").forEach(e => e.disabled = true);
      $("-btn").textContent = "⏳ Consultando... acompanhe o andamento abaixo";
      aviso.textContent = "";
      resolve(JSON.stringify(dados));
    };
  });
})()
